      <main id="main">
        <section class="hero" aria-labelledby="hero-title">
          <div class="hero-copy">
            <p class="eyebrow"><span class="eyebrow-line"></span><span>${eyebrow}</span></p>
            <h1 id="hero-title">${heroTitle}</h1>
            <p class="hero-description">${heroDescription}</p>
            <div class="hero-actions">
              <a class="button button-primary" href="${contact_href}">${heroCta}</a>
              <a class="text-link" href="#approach">${heroMore}</a>
            </div>
          </div>
          <div class="hero-art" aria-hidden="true">
            <div class="art-grid"></div>
            <div class="orbit orbit-one"></div>
            <div class="orbit orbit-two"></div>
            <div class="art-core"><img src="/assets/brand/nut-logo-lime.svg" alt="" width="260" height="260" /></div>
            <span class="art-label art-label-top">01 / THINK</span>
            <span class="art-label art-label-bottom">02 / BUILD</span>
            <span class="art-cross art-cross-one">+</span>
            <span class="art-cross art-cross-two">+</span>
          </div>
        </section>

        <section class="intro section" id="approach" aria-labelledby="approach-title">
          <div class="section-index"><span>01 /</span><span>${sectionLabel}</span></div>
          <div class="intro-content">
            <h2 id="approach-title">${approachTitle}</h2>
            <p>${approachDescription}</p>
            <a class="text-link" href="${skills_url}">${skillsCta} <span aria-hidden="true">↗</span></a>
            <div class="principles">
              <div><span>01</span><h3>${principleOneTitle}</h3><p>${principleOneText}</p></div>
              <div><span>02</span><h3>${principleTwoTitle}</h3><p>${principleTwoText}</p></div>
              <div><span>03</span><h3>${principleThreeTitle}</h3><p>${principleThreeText}</p></div>
            </div>
          </div>
        </section>

        <section class="contact section" id="contact" aria-labelledby="contact-title">
          <div class="section-index"><span>02 /</span><span>${contactLabel}</span></div>
          <div class="contact-content">
            <p class="contact-kicker">${contactKicker}</p>
            <h2 id="contact-title">${contactTitle}</h2>
            <a class="contact-email" href="mailto:info@nut-software.pl">info@nut-software.pl <span aria-hidden="true">↗</span></a>
            <p>${contactDescription}</p>
          </div>
        </section>
      </main>
