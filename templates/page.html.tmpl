<!doctype html>
<html lang="${language}">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101b22" />
    <meta name="description" content="${description}" />
    <title>${title}</title>
${seo_head}
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon.svg?v=walnut" type="image/svg+xml" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="stylesheet" href="${styles_url}" />
    <script src="${script_url}" defer></script>
  </head>
  <body>
    <a class="skip-link" href="#main">${skip}</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href="#top" aria-label="${homeLabel}">
          <img class="brand-mark" src="/assets/brand/nut-logo.svg" alt="" width="44" height="44" />
          <span>nut<span class="brand-dot">.</span>software</span>
        </a>
        <div class="header-actions">
          <nav aria-label="${navLabel}">
            <a href="#approach">${navApproach}</a>
            <a href="#contact">${navContact}</a>
          </nav>
          <a class="language-switch" href="${other_url}" hreflang="${other_language}" lang="${other_language}" aria-label="${switchLabel}">${other_label}</a>
        </div>
      </header>

      <main id="main">
        <section class="hero" id="top" aria-labelledby="hero-title">
          <div class="hero-copy">
            <p class="eyebrow"><span class="eyebrow-line"></span><span>${eyebrow}</span></p>
            <h1 id="hero-title">${heroTitle}</h1>
            <p class="hero-description">${heroDescription}</p>
            <div class="hero-actions">
              <a class="button button-primary" href="${contact_href}">${heroCta}</a>
              <a class="text-link" href="#approach">${heroMore}</a>
            </div>
          </div>
          <div class="hero-art" aria-hidden="true">
            <div class="art-grid"></div>
            <div class="orbit orbit-one"></div>
            <div class="orbit orbit-two"></div>
            <div class="art-core"><img src="/assets/brand/nut-logo-lime.svg" alt="" width="260" height="260" /></div>
            <span class="art-label art-label-top">01 / THINK</span>
            <span class="art-label art-label-bottom">02 / BUILD</span>
            <span class="art-cross art-cross-one">+</span>
            <span class="art-cross art-cross-two">+</span>
          </div>
        </section>

        <section class="intro section" id="approach" aria-labelledby="approach-title">
          <div class="section-index"><span>01 /</span><span>${sectionLabel}</span></div>
          <div class="intro-content">
            <h2 id="approach-title">${approachTitle}</h2>
            <p>${approachDescription}</p>
            <div class="principles">
              <div><span>01</span><h3>${principleOneTitle}</h3><p>${principleOneText}</p></div>
              <div><span>02</span><h3>${principleTwoTitle}</h3><p>${principleTwoText}</p></div>
              <div><span>03</span><h3>${principleThreeTitle}</h3><p>${principleThreeText}</p></div>
            </div>
          </div>
        </section>

        <section class="contact section" id="contact" aria-labelledby="contact-title">
          <div class="section-index"><span>02 /</span><span>${contactLabel}</span></div>
          <div class="contact-content">
            <p class="contact-kicker">${contactKicker}</p>
            <h2 id="contact-title">${contactTitle}</h2>
            <a class="contact-email" href="mailto:info@nut-software.pl">info@nut-software.pl <span aria-hidden="true">↗</span></a>
            <p>${contactDescription}</p>
          </div>
        </section>
      </main>

      <footer class="site-footer">
        <div class="footer-main">
          <section class="company-details" aria-label="${companyHeading}">
            <p class="company-name">Nut Software</p>
            <address>${companyAddress}</address>
            <dl class="company-identifiers">
              <div><dt>NIP</dt><dd>8741681486</dd></div>
              <div><dt>REGON</dt><dd>386776684</dd></div>
            </dl>
          </section>
          <a class="footer-back" href="#top">${backToTop}</a>
        </div>
        <div class="footer-bottom">
          <span>© <span id="year">2026</span> Nut Software</span>
          <span>${footerTagline}</span>
        </div>
      </footer>
    </div>
  </body>
</html>
